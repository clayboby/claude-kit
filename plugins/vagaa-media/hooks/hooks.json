{
  "description": "Checks the media gateway at session start, and relays the stable asset-library URL after every media fetch.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/preflight.sh"],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__(plugin_vagaa-media_media|media)__(video_fetch|image_fetch|music_fetch|storyboard_fetch|director_fetch|workflow_fetch)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/asset-notify.sh"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
