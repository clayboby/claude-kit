{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/preflight.sh"],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_vagaa-dgx_media__(video_fetch|image_fetch|music_fetch|storyboard_fetch)",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/asset-notify.sh"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
